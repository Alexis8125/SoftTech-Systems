---
import Card from '../UI/Card.astro';
---

<section id="nosotros" class="section-padding bg-white">
  <div class="container-lg">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <span class="inline-block px-4 py-2 bg-primary-50 text-primary-700 rounded-full text-sm font-medium mb-4">
          Nuestra Filosofía
        </span>
        <h2 class="heading-2 mb-6">
          Más que Desarrolladores,
          <span class="text-primary-600">Socios Tecnológicos</span>
        </h2>
        
        <div class="space-y-6">
          <p class="text-secondary-600">
            En SoftTech Systems creemos que la tecnología debe ser una herramienta accesible 
            y efectiva para el crecimiento empresarial. No solo desarrollamos software; 
            creamos soluciones que resuelven problemas reales y generan valor tangible.
          </p>
          
          <div class="bg-gradient-to-r from-primary-50 to-blue-50 rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-white rounded-lg border border-primary-200 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-secondary-900 mb-2">Compromiso con la Excelencia</h4>
                <p class="text-sm text-secondary-600">
                  Cada línea de código, cada interfaz y cada funcionalidad son creadas 
                  con el más alto estándar de calidad y atención al detalle.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div>
        <div class="grid grid-cols-2 gap-6">
          <!-- Valor 1 -->
          <Card padding="lg" hover={false}>
            <div class="w-12 h-12 bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23 12l-2.44-2.78.34-3.68-3.61-.82-1.89-3.18L12 3 8.6 1.54 6.71 4.72l-3.61.81.34 3.68L1 12l2.44 2.78-.34 3.69 3.61.82 1.89 3.18L12 21l3.4 1.46 1.89-3.18 3.61-.82-.34-3.68L23 12zm-10 5h-2v-2h2v2zm0-4h-2V7h2v6z"/>
              </svg>
            </div>
            <h4 class="font-semibold text-secondary-900 mb-2">Transparencia Total</h4>
            <p class="text-sm text-secondary-600">
              Mantenemos comunicación abierta y reportes regulares en cada fase del proyecto.
            </p>
          </Card>

          <!-- Valor 2 -->
          <Card padding="lg" hover={false}>
            <div class="w-12 h-12 bg-gradient-to-br from-teal-50 to-teal-100 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-teal-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
              </svg>
            </div>
            <h4 class="font-semibold text-secondary-900 mb-2">Seguridad Garantizada</h4>
            <p class="text-sm text-secondary-600">
              Implementamos las mejores prácticas de seguridad en cada capa de nuestras soluciones.
            </p>
          </Card>

          <!-- Valor 3 -->
          <Card padding="lg" hover={false}>
            <div class="w-12 h-12 bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
              </svg>
            </div>
            <h4 class="font-semibold text-secondary-900 mb-2">Documentación Completa</h4>
            <p class="text-sm text-secondary-600">
              Entregamos documentación detallada para garantizar autonomía y facilidad de uso.
            </p>
          </Card>

          <!-- Valor 4 -->
          <Card padding="lg" hover={false}>
            <div class="w-12 h-12 bg-gradient-to-br from-amber-50 to-amber-100 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-amber-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 6v3l4-4-4-4v3c-4.42 0-8 3.58-8 8 0 1.57.46 3.03 1.24 4.26L6.7 14.8c-.45-.83-.7-1.79-.7-2.8 0-3.31 2.69-6 6-6zm6.76 1.74L17.3 9.2c.44.84.7 1.79.7 2.8 0 3.31-2.69 6-6 6v-3l-4 4 4 4v-3c4.42 0 8-3.58 8-8 0-1.57-.46-3.03-1.24-4.26z"/>
              </svg>
            </div>
            <h4 class="font-semibold text-secondary-900 mb-2">Innovación Continua</h4>
            <p class="text-sm text-secondary-600">
              Nos mantenemos actualizados con las últimas tecnologías y tendencias del mercado.
            </p>
          </Card>
        </div>
      </div>
    </div>

    <!-- Team Approach -->
    <div class="mt-20 bg-gradient-to-r from-secondary-50 to-white rounded-2xl p-8 border border-secondary-100">
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <h3 class="heading-3 mb-4">Enfoque Colaborativo</h3>
          <p class="text-secondary-600 mb-6">
            Trabajamos como una extensión de tu equipo, integrando nuestros expertos 
            en tecnología con tu conocimiento del negocio para lograr resultados excepcionales.
          </p>
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <h4 class="font-semibold text-secondary-900 mb-3">Nuestros Roles</h4>
              <ul class="space-y-2 text-sm text-secondary-600">
                <li class="flex items-center">
                  <span class="w-2 h-2 bg-primary-500 rounded-full mr-2"></span>
                  Arquitectos de Software
                </li>
                <li class="flex items-center">
                  <span class="w-2 h-2 bg-primary-500 rounded-full mr-2"></span>
                  Desarrolladores Full-Stack
                </li>
                <li class="flex items-center">
                  <span class="w-2 h-2 bg-primary-500 rounded-full mr-2"></span>
                  Diseñadores UX/UI
                </li>
              </ul>
            </div>
            <div>
              <h4 class="font-semibold text-secondary-900 mb-3">Metodología</h4>
              <ul class="space-y-2 text-sm text-secondary-600">
                <li class="flex items-center">
                  <span class="w-2 h-2 bg-teal-500 rounded-full mr-2"></span>
                  Desarrollo Ágil
                </li>
                <li class="flex items-center">
                  <span class="w-2 h-2 bg-teal-500 rounded-full mr-2"></span>
                  Reuniones Semanales
                </li>
                <li class="flex items-center">
                  <span class="w-2 h-2 bg-teal-500 rounded-full mr-2"></span>
                  Retroalimentación Constante
                </li>
              </ul>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-center">
          <div class="text-center">
            <div class="text-5xl font-bold text-primary-600 mb-2">98%</div>
            <div class="text-secondary-700 font-medium">Tasa de Retención</div>
            <p class="text-sm text-secondary-500 mt-2">Clientes que continúan trabajando con nosotros</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>