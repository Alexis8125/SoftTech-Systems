---
import Card from '../UI/Card.astro';
---

<section id="proceso" class="section-padding bg-secondary-50">
  <div class="container-lg">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-accent-amber/10 text-accent-amber rounded-full text-sm font-medium mb-4">
        Nuestro Método
      </span>
      <h2 class="heading-2 mb-6">
        Proceso de Desarrollo
        <span class="text-primary-600">Transparente y Colaborativo</span>
      </h2>
      <p class="text-lead">
        Seguimos una metodología probada que garantiza la calidad, transparencia y 
        éxito en cada proyecto que emprendemos.
      </p>
    </div>

    <!-- Process Timeline -->
    <div class="relative">
      <!-- Timeline Line -->
      <div class="hidden lg:block absolute left-1/2 transform -translate-x-1/2 h-full w-0.5 bg-gradient-to-b from-primary-500 via-accent-teal to-accent-purple"></div>

      <!-- Process Steps -->
      <div class="space-y-12 lg:space-y-0">
        <!-- Step 1 -->
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
          <div class="lg:text-right mb-8 lg:mb-0">
            <div class="inline-flex items-center justify-center w-12 h-12 bg-white border-2 border-primary-500 rounded-full text-primary-600 font-bold text-lg shadow-lg mb-4 lg:ml-auto lg:mr-0 mx-auto">
              1
            </div>
            <h3 class="heading-3 mb-4">Análisis y Diagnóstico</h3>
            <p class="text-secondary-600">
              Realizamos un análisis exhaustivo de tus necesidades, procesos actuales 
              y objetivos estratégicos para definir el alcance del proyecto.
            </p>
          </div>
          <div class="lg:col-start-2">
            <Card padding="lg">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4zm2 2H5V5h14v14zm0-16H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-secondary-900 mb-2">Entregables</h4>
                  <ul class="space-y-2 text-sm text-secondary-600">
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-primary-500 rounded-full mr-2"></span>
                      Documento de Requerimientos
                    </li>
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-primary-500 rounded-full mr-2"></span>
                      Plan de Proyecto Detallado
                    </li>
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-primary-500 rounded-full mr-2"></span>
                      Propuesta Técnica y Económica
                    </li>
                  </ul>
                </div>
              </div>
            </Card>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
          <div class="lg:col-start-1 lg:row-start-1 mb-8 lg:mb-0">
            <Card padding="lg">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-teal-50 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-teal-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-secondary-900 mb-2">Metodología</h4>
                  <ul class="space-y-2 text-sm text-secondary-600">
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-teal-500 rounded-full mr-2"></span>
                      Diseño de Arquitectura
                    </li>
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-teal-500 rounded-full mr-2"></span>
                      Prototipado Interactivo
                    </li>
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-teal-500 rounded-full mr-2"></span>
                      Planificación de Sprint
                    </li>
                  </ul>
                </div>
              </div>
            </Card>
          </div>
          <div class="lg:text-left">
            <div class="inline-flex items-center justify-center w-12 h-12 bg-white border-2 border-teal-500 rounded-full text-teal-600 font-bold text-lg shadow-lg mb-4 lg:mr-auto lg:ml-0 mx-auto">
              2
            </div>
            <h3 class="heading-3 mb-4">Diseño y Planificación</h3>
            <p class="text-secondary-600">
              Creamos arquitecturas sólidas y diseños intuitivos, asegurando que cada 
              decisión técnica esté alineada con tus objetivos de negocio.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
          <div class="lg:text-right mb-8 lg:mb-0">
            <div class="inline-flex items-center justify-center w-12 h-12 bg-white border-2 border-accent-purple rounded-full text-accent-purple font-bold text-lg shadow-lg mb-4 lg:ml-auto lg:mr-0 mx-auto">
              3
            </div>
            <h3 class="heading-3 mb-4">Desarrollo Iterativo</h3>
            <p class="text-secondary-600">
              Implementamos en ciclos cortos con revisiones continuas, manteniéndote 
              informado y permitiendo ajustes en tiempo real según tus feedback.
            </p>
          </div>
          <div class="lg:col-start-2">
            <Card padding="lg">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/>
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-secondary-900 mb-2">Prácticas</h4>
                  <ul class="space-y-2 text-sm text-secondary-600">
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-purple-500 rounded-full mr-2"></span>
                      Desarrollo Ágil
                    </li>
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-purple-500 rounded-full mr-2"></span>
                      Code Reviews
                    </li>
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-purple-500 rounded-full mr-2"></span>
                      Testing Continuo
                    </li>
                  </ul>
                </div>
              </div>
            </Card>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
          <div class="lg:col-start-1 lg:row-start-1 mb-8 lg:mb-0">
            <Card padding="lg">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-amber-50 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-amber-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-secondary-900 mb-2">Garantías</h4>
                  <ul class="space-y-2 text-sm text-secondary-600">
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-amber-500 rounded-full mr-2"></span>
                      Pruebas Exhaustivas
                    </li>
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-amber-500 rounded-full mr-2"></span>
                      Documentación Completa
                    </li>
                    <li class="flex items-center">
                      <span class="w-1.5 h-1.5 bg-amber-500 rounded-full mr-2"></span>
                      Plan de Migración
                    </li>
                  </ul>
                </div>
              </div>
            </Card>
          </div>
          <div class="lg:text-left">
            <div class="inline-flex items-center justify-center w-12 h-12 bg-white border-2 border-amber-500 rounded-full text-amber-600 font-bold text-lg shadow-lg mb-4 lg:mr-auto lg:ml-0 mx-auto">
              4
            </div>
            <h3 class="heading-3 mb-4">Implementación y Soporte</h3>
            <p class="text-secondary-600">
              Nos encargamos de la implementación completa y proporcionamos soporte 
              continuo para garantizar el éxito a largo plazo de tu solución.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA Process -->
    <div class="mt-20 text-center">
      <div class="bg-gradient-to-r from-primary-600 to-accent-blue rounded-2xl p-8 text-white">
        <h3 class="text-2xl font-bold mb-4">¿Listo para Transformar tu Negocio?</h3>
        <p class="text-white/90 mb-6 max-w-2xl mx-auto">
          Comienza hoy mismo con una consultoría gratuita. Analizaremos tus necesidades 
          y crearemos una propuesta personalizada sin compromiso.
        </p>
        <a href="#contacto" class="inline-flex items-center justify-center px-8 py-3 bg-white text-primary-600 font-semibold rounded-lg hover:bg-gray-50 transition-colors shadow-lg">
          Solicitar Consultoría Gratis
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>