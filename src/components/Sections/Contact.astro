---
import Card from '../UI/Card.astro';
---

<section id="contacto" class="section-padding bg-gradient-to-b from-white to-secondary-50">
  <div class="container-lg">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-gradient-to-r from-primary-500 to-accent-blue text-white rounded-full text-sm font-medium mb-4">
        Contacto
      </span>
      <h2 class="heading-2 mb-6">
        Hablemos de tu
        <span class="text-primary-600">Proyecto</span>
      </h2>
      <p class="text-lead">
        Cuéntanos sobre tus necesidades y trabajaremos juntos para crear una solución 
        tecnológica que impulse tu crecimiento.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Contact Form -->
      <div>
        <Card padding="lg" className="shadow-xl">
          <h3 class="heading-3 mb-6">Envía tu Mensaje</h3>
          
          <form id="contact-form" class="space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-secondary-700 mb-2">
                  Nombre Completo *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-secondary-200 bg-white focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-colors outline-none"
                  placeholder="Juan Pérez"
                />
              </div>
              
              <div>
                <label for="email" class="block text-sm font-medium text-secondary-700 mb-2">
                  Correo Electrónico *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-secondary-200 bg-white focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-colors outline-none"
                  placeholder="juan@empresa.com"
                />
              </div>
            </div>
            
            <div>
              <label for="company" class="block text-sm font-medium text-secondary-700 mb-2">
                Empresa / Institución
              </label>
              <input
                type="text"
                id="company"
                name="company"
                class="w-full px-4 py-3 rounded-lg border border-secondary-200 bg-white focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-colors outline-none"
                placeholder="Nombre de tu organización"
              />
            </div>
            
            <div>
              <label for="service" class="block text-sm font-medium text-secondary-700 mb-2">
                Área de Interés *
              </label>
              <select
                id="service"
                name="service"
                required
                class="w-full px-4 py-3 rounded-lg border border-secondary-200 bg-white focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-colors outline-none"
              >
                <option value="" disabled selected>Selecciona una opción</option>
                <option value="web">Desarrollo Web</option>
                <option value="consulting">Consultoría Tecnológica</option>
                <option value="maintenance">Soporte y Mantenimiento</option>
                <option value="ams">AMS Inventory's</option>
                <option value="florentia">FlorentIA</option>
                <option value="edutech">EduTech Suite</option>
                <option value="other">Otra Solución</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-secondary-700 mb-2">
                Descripción del Proyecto *
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 rounded-lg border border-secondary-200 bg-white focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-colors outline-none resize-none"
                placeholder="Describe tu proyecto, necesidades específicas o cualquier requerimiento especial..."
              ></textarea>
            </div>
            
            <div class="flex items-start">
              <input
                type="checkbox"
                id="privacy"
                name="privacy"
                required
                class="mt-1 w-4 h-4 text-primary-600 rounded focus:ring-primary-500 border-secondary-300"
              />
              <label for="privacy" class="ml-2 text-sm text-secondary-600">
                Acepto la política de privacidad y autorizo el tratamiento de mis datos 
                personales para fines de contacto y propuesta comercial.
              </label>
            </div>
            
            <button
              type="submit"
              class="w-full px-8 py-4 bg-gradient-to-r from-primary-600 to-accent-blue text-white font-semibold rounded-lg hover:from-primary-700 hover:to-blue-700 transition-all duration-300 transform hover:-translate-y-0.5 shadow-lg hover:shadow-xl"
            >
              Enviar Mensaje
              <svg class="inline-block ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
            </button>
          </form>
          
          <div id="form-success" class="hidden mt-6 p-4 bg-green-50 text-green-700 rounded-lg border border-green-200 animate-fade-in">
            <div class="flex items-center">
              <svg class="w-5 h-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="font-medium">¡Mensaje enviado con éxito!</span>
              <span class="ml-2 text-sm">Te contactaremos en menos de 24 horas hábiles.</span>
            </div>
          </div>
          
          <div id="form-error" class="hidden mt-6 p-4 bg-red-50 text-red-700 rounded-lg border border-red-200 animate-fade-in">
            <div class="flex items-center">
              <svg class="w-5 h-5 text-red-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
              </svg>
              <span class="font-medium">Error al enviar el mensaje</span>
              <span class="ml-2 text-sm">Por favor, inténtalo de nuevo o contáctanos directamente.</span>
            </div>
          </div>
        </Card>
      </div>
      
      <!-- Contact Info & FAQ -->
      <div>
        <!-- Contact Methods -->
        <div class="space-y-6 mb-12">
          <Card padding="lg">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-50 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-secondary-900 mb-1">Correo Electrónico</h4>
                <p class="text-secondary-600">info@softtechsystems.com</p>
                <p class="text-sm text-secondary-500 mt-1">Respuesta en menos de 24 horas</p>
              </div>
            </div>
          </Card>
          
          <Card padding="lg">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-teal-50 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-teal-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-secondary-900 mb-1">Teléfono</h4>
                <p class="text-secondary-600">+1 (555) 123-4567</p>
                <p class="text-sm text-secondary-500 mt-1">Lunes a Viernes, 9:00 - 18:00</p>
              </div>
            </div>
          </Card>
          
          <Card padding="lg">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-amber-50 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-amber-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-secondary-900 mb-1">Oficina Principal</h4>
                <p class="text-secondary-600">Av. Tecnológica 1234, Zona Digital</p>
                <p class="text-sm text-secondary-500 mt-1">Ciudad Tecnológica, CP 12345</p>
              </div>
            </div>
          </Card>
        </div>
        
        <!-- FAQ -->
        <Card padding="lg">
          <h4 class="font-semibold text-secondary-900 mb-4">Preguntas Frecuentes</h4>
          <div class="space-y-4">
            <details class="group">
              <summary class="flex items-center justify-between cursor-pointer list-none text-secondary-700 hover:text-primary-600">
                <span class="font-medium">¿Cuál es el tiempo promedio de desarrollo?</span>
                <span class="transition-transform group-open:rotate-180">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-2 text-sm text-secondary-600">
                Depende del alcance del proyecto. Sitios web simples: 2-4 semanas. 
                Aplicaciones empresariales: 2-6 meses. Proporcionamos cronogramas 
                detallados en la propuesta inicial.
              </div>
            </details>
            
            <details class="group border-t border-secondary-100 pt-4">
              <summary class="flex items-center justify-between cursor-pointer list-none text-secondary-700 hover:text-primary-600">
                <span class="font-medium">¿Ofrecen soporte post-implementación?</span>
                <span class="transition-transform group-open:rotate-180">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-2 text-sm text-secondary-600">
                Sí, ofrecemos planes de soporte que incluyen mantenimiento, actualizaciones 
                de seguridad y asistencia técnica. Todos los detalles están en nuestros 
                contratos de servicio.
              </div>
            </details>
            
            <details class="group border-t border-secondary-100 pt-4">
              <summary class="flex items-center justify-between cursor-pointer list-none text-secondary-700 hover:text-primary-600">
                <span class="font-medium">¿Trabajan con empresas internacionales?</span>
                <span class="transition-transform group-open:rotate-180">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-2 text-sm text-secondary-600">
                Absolutamente. Trabajamos con clientes en múltiples países y adaptamos 
                nuestros procesos para diferentes husos horarios y requerimientos locales.
              </div>
            </details>
          </div>
        </Card>
      </div>
    </div>
  </div>
  
  <script is:inline>
  const contactForm = document.getElementById('contact-form');
  const successMessage = document.getElementById('form-success');
  const errorMessage = document.getElementById('form-error');
  
  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitButton = contactForm.querySelector('button[type="submit"]');
      const originalText = submitButton.innerHTML;
      
      // Show loading state
      submitButton.innerHTML = 'Enviando...';
      submitButton.disabled = true;
      
      // Hide previous messages
      successMessage.classList.add('hidden');
      errorMessage.classList.add('hidden');
      
      try {
        // Simulate API call
        await new Promise(resolve => setTimeout(resolve, 1500));
        
        // Show success
        successMessage.classList.remove('hidden');
        contactForm.reset();
        
        // Scroll to success message
        successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
        
      } catch (error) {
        // Show error
        errorMessage.classList.remove('hidden');
        errorMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } finally {
        // Reset button
        submitButton.innerHTML = originalText;
        submitButton.disabled = false;
      }
    });
  }
  
  // FAQ toggle animation
  document.querySelectorAll('details').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if (detail.open) {
        const content = detail.querySelector('div');
        content.style.animation = 'fadeIn 0.3s ease-out';
      }
    });
  });
</script>
</section>