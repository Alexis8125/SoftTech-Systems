---
import Card from '../UI/Card.astro';
import Button from '../UI/Button.astro';
---

<section id="productos" class="section-padding bg-white">
  <div class="container-lg">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-medium mb-4">
        Nuestros Productos
      </span>
      <h2 class="heading-2 mb-6">
        Soluciones Especializadas para
        <span class="text-primary-600">Necesidades Específicas</span>
      </h2>
      <p class="text-lead">
        Desarrollamos productos de software que resuelven problemas reales con interfaces 
        intuitivas y funcionalidad avanzada.
      </p>
    </div>

    <!-- AMS Inventory's -->
    <div class="mb-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 text-blue-700 rounded-lg text-sm font-medium mb-6">
            <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
            Gestión Empresarial
          </div>
          <h3 class="heading-3 mb-4">AMS Inventory's</h3>
          <p class="text-lead mb-6">
            Sistema integral de gestión empresarial diseñado para optimizar el control de 
            inventario, ventas y operaciones comerciales en tiempo real.
          </p>
          
          <div class="grid sm:grid-cols-2 gap-6 mb-8">
            <div>
              <h4 class="font-semibold text-secondary-900 mb-3">Funcionalidades Clave</h4>
              <ul class="space-y-2">
                <li class="flex items-center text-sm text-secondary-700">
                  <svg class="w-4 h-4 text-blue-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  Control de Stock en Tiempo Real
                </li>
                <li class="flex items-center text-sm text-secondary-700">
                  <svg class="w-4 h-4 text-blue-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  Gestión Multi-Usuario
                </li>
                <li class="flex items-center text-sm text-secondary-700">
                  <svg class="w-4 h-4 text-blue-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  Reportes Analíticos Avanzados
                </li>
              </ul>
            </div>
            <div>
              <h4 class="font-semibold text-secondary-900 mb-3">Beneficios</h4>
              <ul class="space-y-2">
                <li class="flex items-center text-sm text-secondary-700">
                  <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  Reducción de Pérdidas 40%
                </li>
                <li class="flex items-center text-sm text-secondary-700">
                  <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  Automatización de Procesos
                </li>
                <li class="flex items-center text-sm text-secondary-700">
                  <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  Toma de Decisiones Informada
                </li>
              </ul>
            </div>
          </div>
          
          <div class="flex flex-wrap gap-4">
            <Button href="#contacto">Solicitar Demo Gratis</Button>
            <Button variant="outline">Ver Casos de Éxito</Button>
          </div>
        </div>
        
        <div class="order-1 lg:order-2">
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl transform rotate-3"></div>
            <div class="relative bg-white rounded-2xl shadow-2xl overflow-hidden border border-blue-100">
              <div class="p-8 bg-gradient-to-b from-blue-50 to-white">
                <div class="flex items-center justify-between mb-6">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                      <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 16H6c-.55 0-1-.45-1-1V6c0-.55.45-1 1-1h12c.55 0 1 .45 1 1v12c0 .55-.45 1-1 1z"/>
                      </svg>
                    </div>
                    <div>
                      <h4 class="font-bold text-secondary-900">AMS Dashboard</h4>
                      <p class="text-sm text-secondary-500">Panel de Control Principal</p>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-2xl font-bold text-blue-600">95%</div>
                    <div class="text-xs text-secondary-500">Eficiencia</div>
                  </div>
                </div>
                
                <!-- Dashboard Preview -->
                <div class="space-y-3">
                  <div class="h-2 bg-blue-200 rounded-full overflow-hidden">
                    <div class="h-full bg-blue-500 rounded-full w-3/4"></div>
                  </div>
                  <div class="grid grid-cols-3 gap-3">
                    <div class="h-20 bg-blue-50 rounded-lg border border-blue-100 p-3">
                      <div class="text-xs text-blue-600 font-medium mb-1">Stock Total</div>
                      <div class="text-lg font-bold text-secondary-900">1,248</div>
                    </div>
                    <div class="h-20 bg-blue-50 rounded-lg border border-blue-100 p-3">
                      <div class="text-xs text-blue-600 font-medium mb-1">Ventas Hoy</div>
                      <div class="text-lg font-bold text-secondary-900">$4,856</div>
                    </div>
                    <div class="h-20 bg-blue-50 rounded-lg border border-blue-100 p-3">
                      <div class="text-xs text-blue-600 font-medium mb-1">Órdenes</div>
                      <div class="text-lg font-bold text-secondary-900">42</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FlorentIA -->
    <div class="mb-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-green-50 text-green-700 rounded-lg text-sm font-medium mb-6">
            <span class="w-2 h-2 bg-green-500 rounded-full"></span>
            Innovación Educativa
          </div>
          <h3 class="heading-3 mb-4">FlorentIA</h3>
          <p class="text-lead mb-6">
            Plataforma educativa que transforma el aprendizaje en una experiencia inmersiva 
            mediante gamificación y visualización del progreso académico.
          </p>
          
          <div class="mb-8">
            <h4 class="font-semibold text-secondary-900 mb-3">Características Destacadas</h4>
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="bg-green-50 rounded-lg p-4">
                <div class="text-green-600 font-semibold mb-1">Jardines Virtuales</div>
                <p class="text-sm text-secondary-600">El progreso se visualiza como un jardín que florece</p>
              </div>
              <div class="bg-green-50 rounded-lg p-4">
                <div class="text-green-600 font-semibold mb-1">IA Integrada</div>
                <p class="text-sm text-secondary-600">Adaptación personalizada del contenido educativo</p>
              </div>
            </div>
          </div>
          
          <div class="flex flex-wrap gap-4">
            <Button href="#contacto" class="bg-gradient-to-r from-green-600 to-teal-600 hover:from-green-700 hover:to-teal-700">
              Conocer Plataforma
            </Button>
          </div>
        </div>
        
        <div class="order-1">
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-green-400 to-teal-500 rounded-2xl transform -rotate-3"></div>
            <div class="relative bg-white rounded-2xl shadow-2xl overflow-hidden border border-green-100 p-8">
              <div class="flex items-center justify-between mb-6">
                <div>
                  <h4 class="font-bold text-secondary-900">Jardín del Aprendizaje</h4>
                  <p class="text-sm text-secondary-500">Progreso Estudiantil</p>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-bold text-green-600">Nivel 7</div>
                  <div class="text-xs text-secondary-500">Avance Actual</div>
                </div>
              </div>
              
              <div class="grid grid-cols-3 gap-4 mb-6">
                <div class="text-center">
                  <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-2">
                    <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/>
                    </svg>
                  </div>
                  <div class="text-sm font-medium text-secondary-900">Semillas</div>
                </div>
                <div class="text-center">
                  <div class="w-16 h-16 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-2">
                    <svg class="w-8 h-8 text-teal-600" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17 3H7c-1.1 0-1.99.9-1.99 2L5 21l7-3 7 3V5c0-1.1-.9-2-2-2z"/>
                    </svg>
                  </div>
                  <div class="text-sm font-medium text-secondary-900">Plantas</div>
                </div>
                <div class="text-center">
                  <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-2">
                    <svg class="w-8 h-8 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                  </div>
                  <div class="text-sm font-medium text-secondary-900">Logros</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- EduTech Suite -->
    <div>
      <div class="bg-gradient-to-r from-purple-50 to-indigo-50 rounded-2xl p-8 border border-purple-100">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-100 text-purple-700 rounded-lg text-sm font-medium mb-6">
              <span class="w-2 h-2 bg-purple-500 rounded-full animate-pulse"></span>
              Próximo Lanzamiento
            </div>
            <h3 class="heading-3 mb-4">EduTech Suite</h3>
            <p class="text-lead mb-6">
              Plataforma integral de gestión educativa que centraliza todos los procesos 
              académicos y administrativos en un solo ecosistema digital.
            </p>
            
            <div class="mb-8">
              <div class="flex items-center gap-2 mb-4">
                <div class="text-sm text-purple-600 font-medium">Progreso de Desarrollo</div>
                <div class="text-sm font-bold text-secondary-900">75%</div>
              </div>
              <div class="h-2 bg-purple-200 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-purple-500 to-indigo-500 rounded-full w-3/4"></div>
              </div>
            </div>
            
            <div class="flex flex-wrap gap-4">
              <Button href="#contacto" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700">
                Notificarme al Lanzar
              </Button>
            </div>
          </div>
          
          <div>
            <div class="bg-white rounded-xl p-6 border border-purple-200 shadow-lg">
              <h4 class="font-bold text-secondary-900 mb-4">Módulos Principales</h4>
              <div class="grid grid-cols-2 gap-4">
                <div class="bg-purple-50 rounded-lg p-4">
                  <div class="text-purple-600 font-semibold mb-1">Gestión Académica</div>
                  <p class="text-xs text-secondary-600">Administración completa de cursos y estudiantes</p>
                </div>
                <div class="bg-purple-50 rounded-lg p-4">
                  <div class="text-purple-600 font-semibold mb-1">Analítica Educativa</div>
                  <p class="text-xs text-secondary-600">Dashboards avanzados para toma de decisiones</p>
                </div>
                <div class="bg-purple-50 rounded-lg p-4">
                  <div class="text-purple-600 font-semibold mb-1">Recursos Digitales</div>
                  <p class="text-xs text-secondary-600">Biblioteca virtual y materiales interactivos</p>
                </div>
                <div class="bg-purple-50 rounded-lg p-4">
                  <div class="text-purple-600 font-semibold mb-1">Comunicación</div>
                  <p class="text-xs text-secondary-600">Plataforma integrada para toda la comunidad</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>