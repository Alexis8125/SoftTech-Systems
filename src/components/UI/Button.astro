---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  className?: string;
}

const { variant = 'primary', size = 'md', href, className = '' } = Astro.props;

const baseClasses = 'inline-flex items-center justify-center font-semibold transition-all duration-300 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2';
const variantClasses = {
  primary: 'bg-primary-600 text-white hover:bg-primary-700 focus:ring-primary-500 shadow-lg hover:shadow-xl',
  secondary: 'bg-secondary-800 text-white hover:bg-secondary-900 focus:ring-secondary-700 shadow-lg hover:shadow-xl',
  outline: 'bg-transparent text-primary-600 border-2 border-primary-600 hover:bg-primary-50 focus:ring-primary-500'
};
const sizeClasses = {
  sm: 'px-4 py-2 text-sm rounded-lg',
  md: 'px-6 py-3 rounded-lg',
  lg: 'px-8 py-4 text-lg rounded-xl'
};

const buttonClasses = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={buttonClasses}>
      <slot />
    </a>
  ) : (
    <button class={buttonClasses}>
      <slot />
    </button>
  )
}