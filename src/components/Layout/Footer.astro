---
import Button from '../UI/Button.astro';
---

<footer class="bg-gradient-to-b from-secondary-900 to-black text-white">
  <div class="container-lg pt-16 pb-8">
    <div class="grid lg:grid-cols-4 gap-12 mb-12">
      <!-- Company Info -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-gradient-to-br from-primary-500 to-accent-blue rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-display text-xl font-bold">SoftTech</span>
            <span class="text-xs text-secondary-400">Systems</span>
          </div>
        </div>
        <p class="text-secondary-400 mb-6">
          Desarrollamos soluciones tecnológicas que simplifican la forma en que las 
          empresas trabajan, gestionan y crecen.
        </p>
        <div class="flex gap-4">
          <a href="#" class="text-secondary-400 hover:text-white transition-colors">
            <span class="sr-only">LinkedIn</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="#" class="text-secondary-400 hover:text-white transition-colors">
            <span class="sr-only">GitHub</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a href="#" class="text-secondary-400 hover:text-white transition-colors">
            <span class="sr-only">Twitter</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.213c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h4 class="font-display text-lg font-semibold mb-6">Enlaces Rápidos</h4>
        <ul class="space-y-3">
          <li><a href="#soluciones" class="text-secondary-400 hover:text-white transition-colors">Soluciones</a></li>
          <li><a href="#servicios" class="text-secondary-400 hover:text-white transition-colors">Servicios</a></li>
          <li><a href="#productos" class="text-secondary-400 hover:text-white transition-colors">Productos</a></li>
          <li><a href="#nosotros" class="text-secondary-400 hover:text-white transition-colors">Nosotros</a></li>
          <li><a href="#proceso" class="text-secondary-400 hover:text-white transition-colors">Proceso</a></li>
          <li><a href="#contacto" class="text-secondary-400 hover:text-white transition-colors">Contacto</a></li>
        </ul>
      </div>
      
      <!-- Services -->
      <div>
        <h4 class="font-display text-lg font-semibold mb-6">Servicios</h4>
        <ul class="space-y-3">
          <li><a href="#servicios" class="text-secondary-400 hover:text-white transition-colors">Desarrollo Web</a></li>
          <li><a href="#servicios" class="text-secondary-400 hover:text-white transition-colors">Consultoría Tecnológica</a></li>
          <li><a href="#servicios" class="text-secondary-400 hover:text-white transition-colors">Soporte y Mantenimiento</a></li>
          <li><a href="#servicios" class="text-secondary-400 hover:text-white transition-colors">Optimización de Procesos</a></li>
          <li><a href="#servicios" class="text-secondary-400 hover:text-white transition-colors">Migración Digital</a></li>
        </ul>
      </div>
      
      <!-- Newsletter -->
      <div>
        <h4 class="font-display text-lg font-semibold mb-6">Mantente Actualizado</h4>
        <p class="text-secondary-400 mb-4">
          Suscríbete para recibir noticias sobre nuevos productos, casos de éxito 
          y contenido exclusivo sobre transformación digital.
        </p>
        <form class="space-y-3">
          <input
            type="email"
            placeholder="Tu correo electrónico"
            class="w-full px-4 py-3 rounded-lg bg-secondary-800 border border-secondary-700 text-white placeholder-secondary-500 focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-900"
            required
          />
          <Button variant="primary" type="submit" class="w-full justify-center bg-gradient-to-r from-primary-600 to-accent-blue">
            Suscribirse
          </Button>
        </form>
      </div>
    </div>
    
    <!-- Copyright -->
    <div class="pt-8 border-t border-secondary-800">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="text-center md:text-left">
          <p class="text-secondary-400">
            &copy; {new Date().getFullYear()} SoftTech Systems. Todos los derechos reservados.
          </p>
          <p class="text-sm text-secondary-500 mt-1">
            Transformando negocios con tecnología innovadora y soluciones prácticas.
          </p>
        </div>
        
        <div class="flex flex-wrap gap-6 text-sm text-secondary-400">
          <a href="#" class="hover:text-white transition-colors">Política de Privacidad</a>
          <a href="#" class="hover:text-white transition-colors">Términos de Servicio</a>
          <a href="#" class="hover:text-white transition-colors">Cookies</a>
          <a href="#" class="hover:text-white transition-colors">Aviso Legal</a>
        </div>
      </div>
    </div>
  </div>
</footer>